NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tryon:tryon_local_only@localhost:55432/tryon
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tryon-private
S3_ACCESS_KEY=tryon_local
S3_SECRET_KEY=tryon_local_secret_change_me
# Copy the chrome-extension://<ID> origin from chrome://extensions after loading.
CORS_ORIGINS=http://localhost:5173,chrome-extension://REPLACE_WITH_EXTENSION_ID
PROVIDER=fashn
FASHN_API_KEY=
# Explicit test-only mode: PROVIDER=mock. Forbidden when NODE_ENV=production.
# IDM-VTON adapter currently supports original-scene upper-body try-on only.\nENABLE_LIFESTYLE=false
# Set before building a remotely hosted API; localhost is the development default.
VITE_API_URL=http://localhost:4000
TRUST_PROXY=0
